{
  "name": "trustify",
  "version": "2.0.0",
  "description": "A bot for feedback",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "bun run dist/index.js",
    "dev": "bun --watch src/index.ts",
    "build": "bun build index.ts --outdir dist --target bun --sourcemap",
    "build:watch": "bun build index.ts --outdir dist --target bun --sourcemap --watch",
    "clean": "rm -rf dist",
    "prebuild": "bun run clean",
    "test": "bun test"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "discord.js",
    "typescript"
  ],
  "author": "Plxcsy & Blake Co.",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@types/bun": "^1.3.3",
    "@types/pg": "^8.15.6",
    "discord.js": "^14.22.1",
    "dotenv": "^17.2.3",
    "hono": "^4.10.6",
    "mongoose": "^8.19.0",
    "pg": "^8.16.3",
    "prisma": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "bun": ">=1.3.2"
  }
}
