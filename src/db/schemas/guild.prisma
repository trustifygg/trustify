enum Color {
  BLURPLE
  RED
  GREEN
  GREY
}

model Guild {
  guildId               String   @id
  name                  String
  iconUrl               String?
  channel               String   @default("")
  logsChannel           String   @default("")
  anonymousReviews      Boolean  @default(false)
  forceAnonymousReviews Boolean  @default(false)
  createThreads         Boolean  @default(true)
  reviewButton          Boolean  @default(true)
  upvoteButton          Boolean  @default(true)
  ratingEmoji           String   @default("⭐")
  reviewTitle           String   @default("New Review Submitted!")
  customReviewButton    Json?    @default("{\"label\": \"Write a Review\", \"style\": \"BLURPLE\", \"emoji\": \"✍️\"}")
  customReviewEmbed     Json?    @default("{\"title\": \"Thank you for your review!\", \"color\": \"BLURPLE\", \"description\": \"We appreciate your feedback.\", \"footer\": {\"text\": \"Powered by Trustify\"}}")
  customReviewEmbedId   String?  @unique
  reviewRoles           String[] @default([])
  blacklistedRoles      String[] @default([])
  adminRoles            String[] @default([])
  autoReviewRole        String   @default("")
  dmNotification        Json?    @default("{\"enabled\": false, \"message\": \"Thank you for your review!\"}")

  reviews Review[]

  @@map("Guilds")
}
